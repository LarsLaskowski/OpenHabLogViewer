{
  "name": "openhab-log-viewer",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "description": "Live web viewer for openHAB events.log and openhab.log",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/build.mjs",
    "start": "node dist/server/index.cjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/express-rate-limit": "^6.0.2",
    "@types/node": "^25.9.2",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3"
  }
}
