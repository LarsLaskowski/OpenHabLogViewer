{
  "name": "openhab-log-viewer",
  "version": "2.1.7",
  "private": true,
  "type": "module",
  "description": "Live web viewer for openHAB events.log and openhab.log",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/build.mjs",
    "start": "node dist/server/index.cjs",
    "test": "node --import tsx --test src/server/*.test.ts src/client/*.test.ts",
    "test:coverage": "node --import tsx --test --experimental-test-coverage src/server/*.test.ts src/client/*.test.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/express-rate-limit": "^6.0.2",
    "@types/node": "^25.9.3",
    "esbuild": "^0.28.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
