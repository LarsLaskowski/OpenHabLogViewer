{
  "name": "openhab-log-viewer",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Live web viewer for openHAB events.log and openhab.log",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/build.mjs",
    "start": "node dist/server/index.cjs"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.1",
    "esbuild": "^0.25.4",
    "typescript": "^5.8.3"
  }
}
